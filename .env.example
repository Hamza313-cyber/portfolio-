# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# ---- backend (Python, server only) ----
APP_ENV=production
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...            # server only, never NEXT_PUBLIC_
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ADMIN_USER_IDS=your-supabase-user-uuid
ALLOWED_ORIGINS=https://your-site.vercel.app
TURNSTILE_SECRET_KEY=0x...
IP_HASH_SALT=long-random-string
CRON_SECRET=long-random-string-16-plus-chars   # Vercel sends it to /api/keepalive
RATE_LIMIT_COUNT=3
RATE_LIMIT_MINUTES=15

# ---- frontend (public, safe to expose) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
